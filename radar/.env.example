# Konkurs Deal Radar — Umgebungsvariablen
#
# Der Radar braucht KEINE Umgebungsvariablen, um zu laufen. Import aus
# CSV/JSON/PDF funktioniert ohne jede Einrichtung.
#
# Diese Werte werden erst gebraucht, wenn ein Quellen-Adapter mit Zugang
# eingerichtet wird. Sie gehoeren NICHT ins Repo — diese Datei ist nur die
# Vorlage. Auf dem Server als radar/.env anlegen und nicht einchecken.

# Zugangsschluessel eines kommerziellen Datenanbieters, falls einer benutzt
# wird. Welcher Anbieter und ob ueberhaupt einer: das ist eine offene
# Entscheidung, siehe README.
RADAR_API_KEY=

# Wohin die Tagesmeldung geschickt wird. Leer = nur in der Oberflaeche.
RADAR_MELDUNG_WEBHOOK=
